    "region": "us-east-1",
    "architectureNote": "Every Lambda below is a plain Python handler wired directly to API Gateway's Lambda proxy integration. No web framework (FastAPI, Flask, Mangum) runs inside any function — each handler reads event['rawPath'] / event['requestContext']['http']['method'] and dispatches internally. This was an explicit correction to an earlier FastAPI+Mangum draft.",
    "resourcesByType": {
      "lambda": 7,
      "rds": 1,
      "s3": 3,
      "apigateway": 1,
      "secretsmanager": 2,
      "vpc": 1,
      "iam": 1,
      "cloudwatchloggroup": 1,
      "cloudwatchalarm": 1,
      "sns": 1
    },
    "changeLog": [
      {
        "version": "1.0.0",
        "date": "2026-11-07",
        "changes": [
          "Initial release — replaces the earlier FastAPI+Mangum / App Runner draft (see html/frontend-backend-split-plan.html) with direct Lambda-to-API-Gateway integrations, Aurora PostgreSQL Serverless v2, and the existing VPC (see openQuestions below)."
        ]
      }
    ],
    "openQuestions": [
      "Whether any other already-provisioned resource (an existing Secrets Manager secret, an existing S3 bucket, an existing IAM boundary policy) should be referenced instead of the new ones defined here."
    ],
    "vpcDecisionNote": "An AWS CLI sweep of the personal account (294983767092) across 6 regions found no custom-tagged VPC — only the standard AWS default VPC per region, already in light use by unrelated projects (dev-rabbithub-*, wynn-booking-demo-*, bet-hope-*), including a security group (rabbithub-db-sg) open to 0.0.0.0/0 on 5432 that was explicitly not reused. Decision: provision a new, dedicated VPC for this project (LBA-Prod-Security-VPC below), rather than attach to the shared default VPC.",
    "costAnalysis": {
      "monthlyTotal": 71,
      "currency": "USD",
      "basis": "Pilot scale (1-5 LBAs), per html/cost-estimation.html's usage assumptions",
      "breakdown": {
        "compute": {
          "lambda": 3.0,
          "description": "7 functions (6 domain services + 1 authorizer), low memory (256-512MB), well within the 1M-request/400,000 GB-s monthly free tier at pilot volume"
        },
        "api": {
          "apiGateway": 0.05,
          "description": "HTTP API (not REST API — cheaper, native JWT-shape support), ~50K requests/month at $1.00/million"
        },
        "database": {
          "aurora": 47.0,
          "description": "Aurora PostgreSQL Serverless v2, floor of 0.5 ACU sustained (≈$43.80/mo) + 20GB storage + I/O. This is the non-zero idle floor already flagged and accepted — v2 does not pause to literal $0 the way v1 could."
        },
        "storage": {
          "s3": 2.0,
          "description": "3 buckets (uploads, exports, templates), low volume, 7-day lifecycle expiry on generated exports"
        },
        "networking": {
          "natGateway": 0.0,
          "vpcEndpoints": 14.6,
          "description": "No NAT Gateway — this app makes no outbound internet calls, so two interface VPC endpoints (Secrets Manager, CloudWatch Logs) plus a free S3 gateway endpoint are all that's needed for Lambdas in private subnets to reach AWS services. Reuses the existing VPC rather than provisioning a new one."
        },
        "security": {
          "secretsManager": 0.8,
          "description": "2 secrets (Aurora credentials, JWT signing key) at $0.40/secret/month"
        },
        "messaging": {
          "sns": 0.1,
          "description": "1 topic for ops alerts, negligible at this volume"
        },
        "monitoring": {
          "cloudWatch": 4.0,
          "description": "7 Lambda log groups (aggregated below) + 1 error-rate alarm"
        }
      },
      "scalingProjections": [
        { "lbas": 5, "monthlyCost": 71 },
        { "lbas": 25, "monthlyCost": 240 },
        { "lbas": 100, "monthlyCost": 620 }
      ],
      "comparisonNote": "Materially cheaper than the App Runner/Fargate + RDS figures in html/cost-estimation.html at every tier — Lambda's per-request billing has near-zero idle cost for this app's bursty harvest-season traffic, and reusing the existing VPC with endpoint-only networking avoids a ~$33/month NAT Gateway entirely. html/cost-estimation.html should be revised to point here once this architecture is confirmed."
    },
    "totalConnectionEntries": 41,
    "totalUniqueConnections": 24
  },
  "namingConvention": {
    "pattern": "LBA-{Environment}-{Layer}-{Function}",
