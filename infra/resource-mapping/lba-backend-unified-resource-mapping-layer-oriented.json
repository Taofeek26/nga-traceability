    "LBA-Prod-Core-FarmerRegisterService": {
      "id": "LBA-Prod-Core-FarmerRegisterService",
      "name": "Farmer Register Service",
      "type": "lambda",
      "category": "compute",
      "layer": 1,
      "consolidates": [
        "UploadTemplateLinker",
        "MasterDataUploadHandler",
        "FarmersListHandler",
        "FarmerDetailHandler",
        "IncentiveHandler",
        "FarmerToggleActiveHandler",
        "FarmerExportHandler",
        "DataClearHandler"
      ],
      "optional": false,
      "metadata": {
        "type": "Lambda Function",
        "purpose": "Everything touching the farmer register: bulk upload, list/search, per-farmer detail and incentives, and the .xlsx export",
        "description": "Replaces app.py's /upload, /upload/template, /farmers, /farmers/{code}, /farmers/{code}/incentives, /farmers/{code}/toggle-active, /farmers/export, and /data/clear. Parses the uploaded .xlsx with openpyxl exactly as today (same HEADER_ALIASES/_norm_header logic). Never returns a generated export file inline — writes it to the exports bucket and returns a short-lived presigned GET URL instead, per the API Gateway payload-size reasoning in html/frontend-backend-split-plan.html §7.2.",
        "iam_role": "LBA-Prod-Security-FarmerRegisterService-ExecutionRole"
      },
      "connections": {
        "inbound": [
          { "source": "LBA-Prod-Comm-HttpApi", "label": "GET /farmers/upload-template" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "POST /farmers/upload" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "GET /farmers" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "GET /farmers/{code}" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "POST /farmers/{code}/incentives" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "POST /farmers/{code}/toggle-active" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "GET /farmers/export" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "POST /farmers/clear-all" }
        ],
        "outbound": [
          { "target": "lba-prod-db", "label": "SELECT/INSERT/UPDATE farmers, incentives (scoped to lba_id)" },
          { "target": "lba-prod-templates-${AccountId}", "label": "GeneratePresignedUrl (GetObject — static upload template)" },
          { "target": "lba-prod-exports-${AccountId}", "label": "PutObject (generated farmer export) + GeneratePresignedUrl (GetObject)" },
          { "target": "LBA-Prod-Security-DatabaseSecret", "label": "GetSecretValue" }
        ]
      },
      "requirements": ["LBA-REQ-004", "LBA-REQ-005", "LBA-REQ-006"],
      "systems": ["Farmer Management"],
      "definition": {
        "functionName": "LBA-Prod-Core-FarmerRegisterService",
        "handler": "app.lambda_handler",
        "runtime": "python3.12",
        "architecture": "arm64",
        "memorySize": 512,
        "timeout": 30,
        "codeLocation": "backend/src/core/farmer_register_service/",
        "environmentVariables": {
          "LOG_LEVEL": "INFO",
          "DB_SECRET_NAME": "LBA-prod-DatabaseCredentials",
          "DB_HOST": "${AuroraClusterEndpoint}",
          "DB_NAME": "lba_production",
          "DB_PORT": "5432",
          "TEMPLATES_BUCKET": "lba-prod-templates-${AccountId}",
          "EXPORTS_BUCKET": "lba-prod-exports-${AccountId}"
        },
        "tracing": "Active",
        "triggers": [
          { "type": "HttpApi", "path": "/farmers/upload-template", "method": "GET", "authorizer": "LBA-Prod-Security-JwtAuthorizer" },
          { "type": "HttpApi", "path": "/farmers/upload", "method": "POST", "authorizer": "LBA-Prod-Security-JwtAuthorizer" },
          { "type": "HttpApi", "path": "/farmers", "method": "GET", "authorizer": "LBA-Prod-Security-JwtAuthorizer" },
          { "type": "HttpApi", "path": "/farmers/{code}", "method": "GET", "authorizer": "LBA-Prod-Security-JwtAuthorizer" },
          { "type": "HttpApi", "path": "/farmers/{code}/incentives", "method": "POST", "authorizer": "LBA-Prod-Security-JwtAuthorizer" },
          { "type": "HttpApi", "path": "/farmers/{code}/toggle-active", "method": "POST", "authorizer": "LBA-Prod-Security-JwtAuthorizer" },
          { "type": "HttpApi", "path": "/farmers/export", "method": "GET", "authorizer": "LBA-Prod-Security-JwtAuthorizer" },
          { "type": "HttpApi", "path": "/farmers/clear-all", "method": "POST", "authorizer": "LBA-Prod-Security-JwtAuthorizer" }
        ],
        "vpcConfig": {
          "subnetIds": ["PrivateSubnet1", "PrivateSubnet2"],
          "securityGroupIds": ["LambdaSecurityGroup"]
        },
        "policies": [
          { "SecretsAccess": { "actions": ["secretsmanager:GetSecretValue"], "resource": "LBA-prod-DatabaseCredentials" } },
          { "TemplateRead": { "actions": ["s3:GetObject"], "resource": "lba-prod-templates-${AccountId}/*" } },
          { "ExportWrite": { "actions": ["s3:PutObject", "s3:GetObject"], "resource": "lba-prod-exports-${AccountId}/*" } }
        ]
      }
    },
    "LBA-Prod-Core-LotService": {
      "id": "LBA-Prod-Core-LotService",
      "name": "Lot Service",
      "type": "lambda",
      "category": "compute",
      "layer": 1,
      "consolidates": [
        "LotsListHandler",
        "LotEligibilityHandler",
        "LotCreateHandler",
        "LotDetailHandler",
        "LotAcceptHandler",
        "LotRejectHandler",
        "LotExportHandler"
      ],
      "optional": false,
      "metadata": {
        "type": "Lambda Function",
        "purpose": "Lot lifecycle: eligibility check, creation with proportional per-farmer allocation, review (accept/reject), and the delivery-slip export",
        "description": "Replaces app.py's /lots, /lots/new (GET+POST), /lots/{id}, /lots/{id}/accept, /lots/{id}/reject, /lots/{id}/export. Carries over allocation.py's allocation logic and the per-farmer bag-count (floor of 1, derived from weight at 62.5kg/bag) and per-farmer delivered_date randomization unchanged from the current production app. The delivery-slip export is written to the exports bucket with a presigned URL, same pattern as the farmer export.",
        "iam_role": "LBA-Prod-Security-LotService-ExecutionRole"
      },
      "connections": {
        "inbound": [
          { "source": "LBA-Prod-Comm-HttpApi", "label": "GET /lots" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "GET /lots/eligibility" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "POST /lots" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "GET /lots/{id}" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "POST /lots/{id}/accept" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "POST /lots/{id}/reject" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "GET /lots/{id}/export" }
        ],
        "outbound": [
          { "target": "lba-prod-db", "label": "SELECT/INSERT/UPDATE lots, lot_allocations; SELECT farmers (quota + eligibility check)" },
          { "target": "lba-prod-exports-${AccountId}", "label": "PutObject (delivery slip) + GeneratePresignedUrl (GetObject)" },
          { "target": "LBA-Prod-Security-DatabaseSecret", "label": "GetSecretValue" }
        ]
      },
      "requirements": ["LBA-REQ-007", "LBA-REQ-008", "LBA-REQ-009"],
      "systems": ["Lot Tracking & Traceability"],
      "definition": {
        "functionName": "LBA-Prod-Core-LotService",
        "handler": "app.lambda_handler",
        "runtime": "python3.12",
        "architecture": "arm64",
        "memorySize": 512,
        "timeout": 30,
        "codeLocation": "backend/src/core/lot_service/",
        "environmentVariables": {
          "LOG_LEVEL": "INFO",
          "DB_SECRET_NAME": "LBA-prod-DatabaseCredentials",
          "DB_HOST": "${AuroraClusterEndpoint}",
          "DB_NAME": "lba_production",
          "DB_PORT": "5432",
          "EXPORTS_BUCKET": "lba-prod-exports-${AccountId}",
          "STANDARD_BAG_KG": "62.5"
        },
        "tracing": "Active",
        "triggers": [
          { "type": "HttpApi", "path": "/lots", "method": "GET", "authorizer": "LBA-Prod-Security-JwtAuthorizer" },
          { "type": "HttpApi", "path": "/lots/eligibility", "method": "GET", "authorizer": "LBA-Prod-Security-JwtAuthorizer" },
          { "type": "HttpApi", "path": "/lots", "method": "POST", "authorizer": "LBA-Prod-Security-JwtAuthorizer" },
          { "type": "HttpApi", "path": "/lots/{id}", "method": "GET", "authorizer": "LBA-Prod-Security-JwtAuthorizer" },
          { "type": "HttpApi", "path": "/lots/{id}/accept", "method": "POST", "authorizer": "LBA-Prod-Security-JwtAuthorizer" },
          { "type": "HttpApi", "path": "/lots/{id}/reject", "method": "POST", "authorizer": "LBA-Prod-Security-JwtAuthorizer" },
          { "type": "HttpApi", "path": "/lots/{id}/export", "method": "GET", "authorizer": "LBA-Prod-Security-JwtAuthorizer" }
        ],
        "vpcConfig": {
          "subnetIds": ["PrivateSubnet1", "PrivateSubnet2"],
          "securityGroupIds": ["LambdaSecurityGroup"]
        },
        "policies": [
          { "SecretsAccess": { "actions": ["secretsmanager:GetSecretValue"], "resource": "LBA-prod-DatabaseCredentials" } },
          { "ExportWrite": { "actions": ["s3:PutObject", "s3:GetObject"], "resource": "lba-prod-exports-${AccountId}/*" } }
        ]
      }
    },
