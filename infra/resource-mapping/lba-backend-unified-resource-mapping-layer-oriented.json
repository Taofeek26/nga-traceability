  "services": {
    "LBA-Prod-Core-AuthService": {
      "id": "LBA-Prod-Core-AuthService",
      "name": "Auth Service",
      "type": "lambda",
      "category": "compute",
      "layer": 1,
      "consolidates": [
        "SignupHandler",
        "LoginHandler",
        "LogoutHandler",
        "JwtIssuer"
      ],
      "optional": false,
      "metadata": {
        "type": "Lambda Function",
        "purpose": "Create LBA accounts, authenticate users, and issue JWTs — no framework, plain dict-in/dict-out handler",
        "description": "Replaces app.py's /signup and /login POST handlers. Hashes passwords with bcrypt exactly as auth.py does today, but issues a signed JWT in the response body instead of setting a cookie (the frontend now lives on a different origin — see html/frontend-backend-split-plan.html §7.1). The GET /signup and GET /login routes that only rendered an empty form no longer exist on the backend at all; the React frontend renders those forms itself.",
        "iam_role": "LBA-Prod-Security-AuthService-ExecutionRole"
      },
      "connections": {
        "inbound": [
          { "source": "LBA-Prod-Comm-HttpApi", "label": "POST /auth/signup" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "POST /auth/login" },
          { "source": "LBA-Prod-Comm-HttpApi", "label": "POST /auth/logout" }
        ],
        "outbound": [
          { "target": "lba-prod-db", "label": "INSERT/SELECT lbas, users (signup, login verification)" },
          { "target": "LBA-Prod-Security-DatabaseSecret", "label": "GetSecretValue" },
          { "target": "LBA-Prod-Security-JwtSigningKey", "label": "GetSecretValue (sign new tokens)" }
        ]
      },
      "requirements": ["LBA-REQ-001", "LBA-REQ-002"],
      "systems": ["Authentication & Access"],
      "definition": {
        "functionName": "LBA-Prod-Core-AuthService",
        "handler": "app.lambda_handler",
        "runtime": "python3.12",
        "architecture": "arm64",
        "memorySize": 256,
        "timeout": 10,
        "codeLocation": "backend/src/core/auth_service/",
        "environmentVariables": {
          "LOG_LEVEL": "INFO",
          "DB_SECRET_NAME": "LBA-prod-DatabaseCredentials",
          "DB_HOST": "${AuroraClusterEndpoint}",
          "DB_NAME": "lba_production",
          "DB_PORT": "5432",
          "JWT_SECRET_NAME": "LBA-prod-JwtSigningKey",
          "JWT_MAX_AGE_SECONDS": "2592000"
        },
        "tracing": "Active",
        "triggers": [
          { "type": "HttpApi", "path": "/auth/signup", "method": "POST", "authorizer": "none" },
          { "type": "HttpApi", "path": "/auth/login", "method": "POST", "authorizer": "none" },
          { "type": "HttpApi", "path": "/auth/logout", "method": "POST", "authorizer": "LBA-Prod-Security-JwtAuthorizer" }
        ],
        "vpcConfig": {
          "subnetIds": ["PrivateSubnet1", "PrivateSubnet2"],
          "securityGroupIds": ["LambdaSecurityGroup"]
        },
        "policies": [
          {
            "SecretsAccess": {
              "actions": ["secretsmanager:GetSecretValue"],
              "resource": "LBA-prod-DatabaseCredentials"
            }
          },
          {
            "JwtSecretAccess": {
              "actions": ["secretsmanager:GetSecretValue"],
              "resource": "LBA-prod-JwtSigningKey"
            }
          }
        ]
      }
    },
